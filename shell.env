export AWS_CONFIG_ENABLED='true'
export CICD='false'
export DEFAULT_GIT_BRANCH='main'
export DEVELOPER_NAME='dummy-user'
export GIT_PROVIDER_URL='github.com'
export GIT_USER='dummy-user'
export GIT_USER_EMAIL='dummy@user.com'
export GIT_TOKEN='dummy-credentials-token'
export EXTRA_APT_PACKAGES=''
export PAGER='cat'
export AWS_DEFAULT_OUTPUT='json'
export CLI_VERSION='1.14.1'
export PATH="$HOME/.asdf/shims:$HOME/.asdf/bin:/workspaces/windsurf-debug-devcontainer-example/.localscripts:$PATH"

unset GIT_EDITOR
