# Server installation script
DISABLE_SERVER_CHECKSUM="false"
TMP_DIR="${XDG_RUNTIME_DIR:-"/tmp"}"

DISTRO_VSCODE_VERSION="1.106.0"
DISTRO_WINDSURF_VERSION="1.9544.26"
DISTRO_COMMIT="c378df247aa57450376bd5346440192e1549717d"
DISTRO_ID="c378df247aa57450376bd5346440192e1549717d"
DISTRO_QUALITY="stable"
DISTRO_VSCODIUM_RELEASE=""

SERVER_APP_NAME="windsurf-server"
SERVER_INITIAL_EXTENSIONS="--install-extension aws-scripting-guy.cform --install-extension amazonwebservices.aws-toolkit-vscode --install-extension eamodio.gitlens --install-extension GitHub.vscode-pull-request-github --install-extension GitHub.vscode-github-actions --install-extension ms-azuretools.vscode-docker --install-extension ms-python.debugpy --install-extension charliermarsh.ruff --install-extension ms-python.python --install-extension ms-python.vscode-pylance --install-extension redhat.vscode-yaml --install-extension streetsidesoftware.code-spell-checker --install-extension wayou.vscode-todo-highlight --install-extension vscjava.vscode-java-pack --install-extension redhat.java --install-extension anthropic.claude-code"
SERVER_LISTEN_FLAG="--port=0"
SERVER_DATA_DIR="$HOME/.windsurf-server"
SERVER_DIR="$SERVER_DATA_DIR/bin/$DISTRO_ID"
SERVER_SCRIPT="$SERVER_DIR/bin/$SERVER_APP_NAME"
SERVER_LOGFILE="$SERVER_DATA_DIR/.$DISTRO_ID.log"
SERVER_PIDFILE="$SERVER_DATA_DIR/.$DISTRO_ID.pid"
SERVER_TOKENFILE="$SERVER_DATA_DIR/.$DISTRO_ID.token"
SERVER_SSH_AGENT_SOCKET="$SERVER_DATA_DIR/.$DISTRO_ID-ssh-auth.sock"
SERVER_ARCH=
SERVER_CONNECTION_TOKEN=
SERVER_DOWNLOAD_URL=

LISTENING_ON=
OS_RELEASE_ID=
ARCH=
PLATFORM=
SERVER_PID=

GLIBC_VERSION_GOOD=

# Add lock mechanism
LOCK_FILE="$SERVER_DATA_DIR/.installation_lock"

# Function to acquire lock
acquire_lock() {
	exec 200>$LOCK_FILE
	echo "Waiting for lock..."
	flock 200
	echo "Lock acquired, proceeding with installation."
}

# Function to release lock
release_lock() {
	flock -u 200
	exec 200>&-
}

trap release_lock EXIT INT TERM

# Mimic output from logs of remote-ssh extension
print_install_results_and_exit() {
	if [[ $1 -eq 1 ]]; then
		echo ""
		echo "Error: installation failed."
		if [[ -f "$SERVER_LOGFILE" ]]; then
			echo "Server log:
 $(cat "$SERVER_LOGFILE")
"
		fi
	fi
	if [[ "$GLIBC_VERSION_GOOD" = "false" ]]; then
		echo "Warning: valid glibc version not found. Windsurf only supports remote connections with glibc >= 2.28, such as Ubuntu 20.04, Debian 10, or CentOS 8."
		echo ""
	fi
	echo "fb22c3649f560e95548e87ef: start"
	echo "exitCode==$1=="
	echo "listeningOn==$LISTENING_ON=="
	echo "connectionToken==$SERVER_CONNECTION_TOKEN=="
	echo "logFile==$SERVER_LOGFILE=="
	echo "osReleaseId==$OS_RELEASE_ID=="
	echo "arch==$ARCH=="
	echo "platform==$PLATFORM=="
	echo "tmpDir==$TMP_DIR=="
	
	echo "fb22c3649f560e95548e87ef: end"

	exit 0
}

delete_server() {
	if [[ -n "$OLD_DISTRO_ID" ]]; then
		echo "Cleaning up files for $OLD_DISTRO_ID..."
		rm -rf "$SERVER_DATA_DIR/bin/$OLD_DISTRO_ID"
		rm -f "$SERVER_DATA_DIR/.$OLD_DISTRO_ID.pid"
		rm -f "$SERVER_DATA_DIR/.$OLD_DISTRO_ID.log"
		rm -f "$SERVER_DATA_DIR/.$OLD_DISTRO_ID.token"
		rm -f "$SERVER_DATA_DIR/.$OLD_DISTRO_ID-ssh-auth.sock"
		echo "$OLD_DISTRO_ID cleaned up."
	fi
}

clean_up_old_servers() {
	echo "Cleaning up old server installations..."
	if [[ -d "$SERVER_DATA_DIR/bin" ]]; then
		for OLD_DISTRO_DIR_FULL_PATH in "$SERVER_DATA_DIR"/bin/*; do
			if [[ -d "$OLD_DISTRO_DIR_FULL_PATH" ]]; then
				OLD_DISTRO_ID=$(basename "$OLD_DISTRO_DIR_FULL_PATH")

				if [[ "$OLD_DISTRO_ID" = "$DISTRO_ID" ]]; then
					continue
				fi

				echo "Checking old server: $OLD_DISTRO_ID"
				OLD_SERVER_PIDFILE="$SERVER_DATA_DIR/.$OLD_DISTRO_ID.pid"

				echo "Old server PID file: $OLD_SERVER_PIDFILE"

				NUMBER_OF_EXECUTABLES=$(find "$OLD_DISTRO_DIR_FULL_PATH/bin/" -maxdepth 1 -type f -executable | wc -l)
				if (( $NUMBER_OF_EXECUTABLES == 0 )); then
					echo "No executables found in $OLD_DISTRO_DIR_FULL_PATH/bin/"
					delete_server
					continue
				elif (( $NUMBER_OF_EXECUTABLES > 1 )); then
					echo "Multiple executables found in $OLD_DISTRO_DIR_FULL_PATH/bin/, leaving it alone."
					continue
				else
					OLD_SERVER_SCRIPT=$(find "$OLD_DISTRO_DIR_FULL_PATH/bin/" -maxdepth 1 -type f -executable)
					echo "Old server script: $OLD_SERVER_SCRIPT"
				fi

				OLD_SERVER_SCRIPT_PATH=$(readlink -f "$OLD_SERVER_SCRIPT")
				echo "Old server script path: $OLD_SERVER_SCRIPT_PATH"

				if [[ -z "$OLD_SERVER_SCRIPT_PATH" ]]; then
					echo "Something went wrong, old server script path is empty. Skipping old server $OLD_DISTRO_ID."
					continue
				fi

				if [[ ! -f "$OLD_SERVER_PIDFILE" ]]; then
					OLD_PID=$(pgrep -f "$OLD_SERVER_SCRIPT_PATH")
					if [[ -n "$OLD_PID" ]]; then
						touch "$OLD_SERVER_PIDFILE"
						echo "$OLD_PID" > "$OLD_SERVER_PIDFILE"
						echo "Wrote to PID file for $OLD_DISTRO_ID: $OLD_SERVER_PIDFILE"
					fi
				fi

				if [[ -f "$OLD_SERVER_PIDFILE" ]]; then
					OLD_PID=$(cat "$OLD_SERVER_PIDFILE")
					echo "Old server PID: $OLD_PID"
					if [[ -z "$OLD_PID" ]]; then
						OLD_PID=$(pgrep -f "$OLD_SERVER_SCRIPT_PATH")
						if [[ -n "$OLD_PID" ]]; then
							echo "$OLD_PID" > "$OLD_SERVER_PIDFILE"
							echo "Restored PID file for $OLD_DISTRO_ID: $OLD_SERVER_PIDFILE."
						fi
					fi
					# Check if PID is non-empty and if process with OLD_PID is running
					if [[ -n "$OLD_PID" ]] && ps -p "$OLD_PID" > /dev/null 2>&1; then
						OLD_RUNNING_PROCESS="$(ps -o pid,args -p $OLD_PID | grep -F $OLD_SERVER_SCRIPT_PATH)"
						if [[ -n "$OLD_RUNNING_PROCESS" ]]; then
							echo "Old server $OLD_DISTRO_ID (PID $OLD_PID) is running."
						fi
					else
						echo "Old server $OLD_DISTRO_ID (PID $OLD_PID) is not running."
						delete_server
						continue
					fi
				else
					echo "No PID file found for old server $OLD_DISTRO_ID ($OLD_SERVER_PIDFILE) and no processes matching the script path."
					delete_server
					continue
				fi
			fi
		done
		echo "Finished cleaning up old server installations."
	else
		echo "No server bin directory found at $SERVER_DATA_DIR/bin. Skipping cleanup of old servers."
	fi
}

terminateTree() {
	for cpid in $(/usr/bin/pgrep -P $1); do
		terminateTree $cpid
	done
	kill -9 $1 > /dev/null 2>&1
}

kill_running_server() {
	if [[ -n "$1" ]]; then
		echo "Killing server process with PID $1 (and all its children)"
		terminateTree $1
	fi
}

# Check if platform is supported
KERNEL="$(uname -s)"
case $KERNEL in
	Darwin)
		PLATFORM="darwin"
		;;
	Linux)
		PLATFORM="linux"
		;;
	FreeBSD)
		PLATFORM="freebsd"
		;;
	DragonFly)
		PLATFORM="dragonfly"
		;;
	*)
		echo "Error platform not supported: $KERNEL"
		print_install_results_and_exit 1
		;;
esac

# Check machine architecture
ARCH="$(uname -m)"
case $ARCH in
	x86_64 | amd64)
		SERVER_ARCH="x64"
		;;
	armv7l | armv8l)
		SERVER_ARCH="armhf"
		;;
	arm64 | aarch64)
		SERVER_ARCH="arm64"
		;;
	ppc64le)
		SERVER_ARCH="ppc64le"
		;;
	riscv64)
		SERVER_ARCH="riscv64"
		;;
	*)
		echo "Error architecture not supported: $ARCH"
		print_install_results_and_exit 1
		;;
esac

# Attempt to get checksum from manifest

if [[ "$DISTRO_QUALITY" = "insider" ]]; then
	MANIFEST_URL="https://windsurf-nightly.codeiumdata.com/${PLATFORM}-reh-${SERVER_ARCH}/${DISTRO_QUALITY}/manifest-${DISTRO_COMMIT}.json"
else
	MANIFEST_URL="https://windsurf-stable.codeiumdata.com/${PLATFORM}-reh-${SERVER_ARCH}/${DISTRO_QUALITY}/manifest-${DISTRO_COMMIT}.json"
fi

if [[ $DISABLE_SERVER_CHECKSUM = "true" ]]; then
	SHA256_HASH=""
else
	# Curl the manifest URL, and get the sha256 hash
	SHA256_HASH="$(curl -s "$MANIFEST_URL" --max-time 5 | grep -o '"sha256hash": "[^"]*"' | sed 's/"sha256hash": "\(.*\)"/\1/')"

	if [[ $? -ne 0 || -z $SHA256_HASH ]]; then
		echo "Warning: could not get sha256 hash from manifest: will not verify checksum."
		SHA256_HASH=""
	fi

	if ! sha256sum --version > /dev/null 2>&1; then
		echo "Warning: sha256sum could not be found: will not verify checksum."
		SHA256_HASH=""
	fi
fi

# https://www.freedesktop.org/software/systemd/man/os-release.html
OS_RELEASE_ID="$(grep -i '^ID=' /etc/os-release 2>/dev/null | sed 's/^ID=//gi' | sed 's/"//g')"
if [ -z $OS_RELEASE_ID ]; then
	OS_RELEASE_ID="$(grep -i '^ID=' /usr/lib/os-release 2>/dev/null | sed 's/^ID=//gi' | sed 's/"//g')"
	if [ -z $OS_RELEASE_ID ]; then
		OS_RELEASE_ID="unknown"
	fi
fi

# Create installation folder
if [ ! -d $SERVER_DIR ]; then
	mkdir -p $SERVER_DIR
	if (( $? > 0 )); then
		echo "Error creating server install directory"
		print_install_results_and_exit 1
	fi
fi

# Acquire lock at the beginning of the script
acquire_lock

# Add trap to release lock on exit
trap release_lock EXIT

clean_up_old_servers

if [ -n "$SSH_AUTH_SOCK" ]; then
	ln -s -f $SSH_AUTH_SOCK $SERVER_SSH_AGENT_SOCKET
fi
export SSH_AUTH_SOCK=$SERVER_SSH_AGENT_SOCKET


SERVER_DOWNLOAD_URL="$(echo "https://windsurf-stable.codeiumdata.com/\${os}-reh-\${arch}/\${quality}/\${commit}/windsurf-reh-\${os}-\${arch}-\${windsurfVersion}.tar.gz" | sed "s/\${quality}/$DISTRO_QUALITY/g" | sed "s/\${vscodeVersion}/$DISTRO_VSCODE_VERSION/g" | sed "s/\${commit}/$DISTRO_COMMIT/g" | sed "s/\${os}/$PLATFORM/g" | sed "s/\${arch}/$SERVER_ARCH/g" | sed "s/\${release}/$DISTRO_VSCODIUM_RELEASE/g" | sed "s/\${windsurfVersion}/$DISTRO_WINDSURF_VERSION/g")"

if [[ "$PLATFORM" == "linux" ]]; then
	# Check ldd version based on format "ldd (.*) 2.28"
	version=$(ldd --version | head -n 1 | grep -oE '[0-9]+.[0-9]+$')
	if (( $? > 0 )); then
		echo "Warning: ldd not found"
		GLIBC_VERSION_GOOD="false"
	else
		major=$(echo "$version" | cut -d '.' -f 1)
		minor=$(echo "$version" | cut -d '.' -f 2)

		if [[ "$major" -eq 2 && "$minor" -ge 28 ]]; then
			GLIBC_VERSION_GOOD="true"
		else
			GLIBC_VERSION_GOOD="false"
		fi
	fi

	if [[ "$GLIBC_VERSION_GOOD" = "false" ]]; then
		echo "Warning: valid glibc version not found. Windsurf only supports remote connections with glibc >= 2.28, such as Ubuntu 20.04, Debian 10, or CentOS 8."
	fi
fi

# Check if server script is already installed
if [ ! -f $SERVER_SCRIPT ]; then
	if [ "$PLATFORM" != "darwin" ] && [ "$PLATFORM" != "linux" ]; then
		echo "Error "$PLATFORM" needs manual installation of remote extension host"
		print_install_results_and_exit 1
	fi

	pushd $SERVER_DIR > /dev/null

	temp_file=$(mktemp)
	if [ ! -z $(which curl) ]; then
		curl --retry 3 --connect-timeout 10 --location --show-error --silent --output $temp_file $SERVER_DOWNLOAD_URL
	elif [ ! -z $(which wget) ]; then
		wget --tries=3 --timeout=10 --continue --quiet -O $temp_file $SERVER_DOWNLOAD_URL
	else
		echo "Error no tool to download server binary"
		print_install_results_and_exit 1
	fi

	if (( $? > 0 )); then
		echo "Error downloading server from $SERVER_DOWNLOAD_URL"
		print_install_results_and_exit 1
	fi

	mv $temp_file vscode-server.tar.gz

	# Before extracting it, check the checksum
	if [[ ! -z $SHA256_HASH ]]; then
		# Calculate the checksum of the downloaded file
		CALCULATED_HASH="$(sha256sum vscode-server.tar.gz | cut -d ' ' -f 1)"
		
		# Compare with the expected hash
		if [[ "$CALCULATED_HASH" != "$SHA256_HASH" ]]; then
			echo "Error: Checksum verification failed: this usually means the server failed to download correctly."
			echo "Expected: $SHA256_HASH"
			echo "Got: $CALCULATED_HASH"

			rm -f vscode-server.tar.gz

			print_install_results_and_exit 1
		else
			echo "Checksum verification passed: $CALCULATED_HASH"
		fi
	else 
		echo "Skipping checksum verification"
	fi

	tar -xf vscode-server.tar.gz --strip-components 1
	if (( $? > 0 )); then
		echo "Error while extracting server contents"
		print_install_results_and_exit 1
	fi

	if [ ! -f $SERVER_SCRIPT ]; then
		echo "Error server contents are corrupted"
		print_install_results_and_exit 1
	fi

	rm -f vscode-server.tar.gz

	popd > /dev/null
else
	echo "Server script already installed in $SERVER_SCRIPT"
fi

# Try to find if server is already running
if [[ -f $SERVER_PIDFILE ]]; then
	SERVER_PID="$(cat $SERVER_PIDFILE)"
	if [[ -z $SERVER_PID ]]; then
		SERVER_PID=$(pgrep -f "$SERVER_SCRIPT")
		if [[ -n $SERVER_PID ]]; then
			touch $SERVER_PIDFILE
			echo $SERVER_PID > $SERVER_PIDFILE
		fi
	fi
	if [[ -n $SERVER_PID ]]; then
		if [[ -n $(ps -o pid,args -p $SERVER_PID | grep $SERVER_SCRIPT) ]]; then
			SERVER_RUNNING_PROCESS="$SERVER_PID"
			echo "Found running server process: $SERVER_RUNNING_PROCESS"
		fi
	fi
else
	SERVER_RUNNING_PROCESS="$(pgrep -f "$SERVER_SCRIPT")"
	if [[ -z $SERVER_RUNNING_PROCESS ]]; then
		SERVER_PID=
	else
		SERVER_PID=$SERVER_RUNNING_PROCESS
		touch $SERVER_PIDFILE
		echo $SERVER_PID > $SERVER_PIDFILE
	fi
fi

if [ -z "$SERVER_RUNNING_PROCESS" ]; then
	if [ -f "$SERVER_LOGFILE" ]; then
		rm $SERVER_LOGFILE
	fi
	if [ -f "$SERVER_TOKENFILE" ]; then
		rm $SERVER_TOKENFILE
	fi

	touch $SERVER_TOKENFILE
	chmod 600 $SERVER_TOKENFILE
	SERVER_CONNECTION_TOKEN="776107945327"
	echo $SERVER_CONNECTION_TOKEN > $SERVER_TOKENFILE

	export REMOTE_CONTAINERS=true

	$SERVER_SCRIPT --start-server --host=127.0.0.1 $SERVER_LISTEN_FLAG $SERVER_INITIAL_EXTENSIONS --connection-token-file $SERVER_TOKENFILE --telemetry-level off --enable-remote-auto-shutdown --accept-server-license-terms &> $SERVER_LOGFILE & disown
	echo $! > $SERVER_PIDFILE
	SERVER_PID=$(cat $SERVER_PIDFILE)
else
	echo "Server script is already running $SERVER_SCRIPT"
fi

if [[ -f $SERVER_TOKENFILE && -n $(cat $SERVER_TOKENFILE) ]]; then
	SERVER_CONNECTION_TOKEN="$(cat $SERVER_TOKENFILE)"
else
	echo "Error server token file not found $SERVER_TOKENFILE"
	if [[ -n $SERVER_PID ]]; then
		kill_running_server $SERVER_PID
	fi
	print_install_results_and_exit 1
fi

if [ -f "$SERVER_LOGFILE" ]; then
	for i in {1..5}; do
		LISTENING_ON="$(cat $SERVER_LOGFILE | grep -E 'Extension host agent listening on .+' | sed 's/Extension host agent listening on //')"
		if [ -n "$LISTENING_ON" ]; then
			break
		fi
		sleep 0.5
	done

	if [ -z "$LISTENING_ON" ]; then
		echo "Error server did not start sucessfully"
		if [[ -n $SERVER_PID ]]; then
			kill_running_server $SERVER_PID
		fi
		print_install_results_and_exit 1
	fi
else
	echo "Error server log file not found $SERVER_LOGFILE"
	if [[ -n $SERVER_PID ]]; then
		kill_running_server $SERVER_PID
	fi
	print_install_results_and_exit 1
fi

# Finish server setup
print_install_results_and_exit 0

